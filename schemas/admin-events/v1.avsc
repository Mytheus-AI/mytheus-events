{
  "type": "record",
  "name": "AdminEvent",
  "namespace": "io.nexus.events",
  "doc": "admin-events value. Subject: admin-events-value. Compat: BACKWARD. Net-new (not frozen canon). Producer admin-ops-service; flag-changed/tenant-suspended/erasure-requested. Topic is log-compacted; mirrored to audit_logs.",
  "fields": [
    { "name": "header",      "type": "io.nexus.events.EventEnvelopeHeader" },
