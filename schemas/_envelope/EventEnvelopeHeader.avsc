{
  "type": "record",
  "name": "EventEnvelopeHeader",
  "namespace": "io.nexus.events",
  "doc": "Shared header prepended to every NEXUS event value. Frozen field order; new fields append-only with defaults (BACKWARD). Verbatim from 07-event-architecture.md 3.1 and _canon/03-event-taxonomy.md.",
  "fields": [
    { "name": "event_id",        "type": { "type": "string", "logicalType": "uuid" }, "doc": "Unique per emitted event; distinct from idempotency_key." },
    { "name": "idempotency_key",  "type": "string", "doc": "Business dedupe key; stable across producer retries of the same fact." },
    { "name": "org_id",           "type": { "type": "string", "logicalType": "uuid" }, "doc": "Tenant root. Also the Kafka partition key. RLS/cell scoping anchor. Mandatory on every event." },
    { "name": "schema_version",   "type": "int", "default": 1, "doc": "Producer's payload schema version (observability; Registry enforces compat independently)." },
    { "name": "producer",         "type": "string", "doc": "Owning service name (kebab-case, from the Service Catalog)." },
    { "name": "occurred_at",      "type": { "type": "long", "logicalType": "timestamp-micros" }, "doc": "When the fact happened (UTC); not enqueue time." },
    { "name": "correlation_id",   "type": ["null", "string"], "default": null, "doc": "Ties a causal chain across topics." },
    { "name": "causation_id",     "type": ["null", "string"], "default": null, "doc": "event_id of the direct cause; null for root events." }
  ]
}
